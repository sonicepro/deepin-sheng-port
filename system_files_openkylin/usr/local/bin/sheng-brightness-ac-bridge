#!/usr/bin/env python3
# sheng-brightness-ac-bridge  (bidirectional)
# ---------------------------------------------------------------------------
# openKylin 3.0 on the Xiaomi Pad 6S Pro (sheng): make the control-center
# "设置 -> 显示器 -> 亮度" slider drive AND reflect the screen brightness.
#
# Root cause (verified on device):
#   ukui-control-center's libdisplay.so decides between the compositor gamma
#   path (org.ukui.SettingsDaemon setPrimaryBrightness) and a "hardware" path in
#   ukcc::UkccCommon::isSetGammaBrightness(). On sheng the latter returns false
#   (upm present but CanSetBrightness=false; product name is not "VAH510"/"all
#   in one"; no "gammaforbrightness" key), so the Display slider only writes the
#   gsettings key org.ukui.power-manager brightness-ac -- which the power stack
#   (upm) is supposed to apply but CANNOT here (upm's brightness is x86-DMI
#   gated and disabled: "no effective node"). The quick-settings / sidebar
#   slider works because it calls setPrimaryBrightness directly (gamma path).
#
# This bridge ties the two together, in both directions:
#   A) brightness-ac changes  ->  setPrimaryBrightness(value)   (make the
#      Display slider actually change the screen).
#   B) current UKUI brightness ->  brightness-ac               (make the Display
#      slider reflect the real brightness, e.g. after the sidebar / quick
#      settings / auto-brightness changed it -- i.e. "listen to current
#      brightness").
# No binary patching.
#
# No initial apply: brightness-ac defaults to 100.0; applying it at login would
# peg the screen to maximum. We only act on changes (A) and on live brightness
# (B). Direction B is suppressed while brightness-ac is actively changing (a
# drag), and uses a small tolerance, so it never fights the user's drag.
#
# Runs as the desktop user (luser) so it can reach the session bus.
# ---------------------------------------------------------------------------
import os
import subprocess
import sys
import threading
import time

SCHEMA = "org.ukui.power-manager"
KEY = "brightness-ac"
DEST = "org.ukui.SettingsDaemon"
OBJ = "/GlobalBrightness"
IFACE = "org.ukui.SettingsDaemon.Brightness"

POLL = 1.0        # seconds between reading the current brightness (direction B)
STABLE = 2.5      # don't reflect while brightness-ac changed within this window
TOL = 3           # only reflect when |current - brightness-ac| >= this

DEBUG = "--debug" in sys.argv or bool(os.environ.get("SHENG_BRIDGE_DEBUG"))

_lock = threading.Lock()
_last_ac_change = 0.0
_last_forward = None


def warn(msg):
    sys.stderr.write("sheng-brightness-ac-bridge: %s\n" % msg)
    sys.stderr.flush()


def _clamp(v):
    return max(1, min(100, int(round(v))))


def get_ac():
    """Read the gsettings brightness-ac value (float) or None."""
    try:
        out = subprocess.run(["gsettings", "get", SCHEMA, KEY],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        return float(out)
    except Exception:
        return None


def set_ac(v):
    try:
        subprocess.run(["gsettings", "set", SCHEMA, KEY, str(int(round(v)))],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except Exception as e:
        warn("gsettings set brightness-ac failed: %s" % e)


def set_primary(v):
    """Ask UKUI to set the primary screen brightness (gamma path)."""
    try:
        subprocess.run(
            ["dbus-send", "--session", "--print-reply", "--dest=" + DEST,
             OBJ, IFACE + ".setPrimaryBrightness", "uint32:%d" % v],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except Exception as e:
        warn("setPrimaryBrightness(%d) failed: %s" % (v, e))


def get_primary():
    """Read the daemon's current primary brightness (int) or None."""
    try:
        out = subprocess.run(
            ["busctl", "--user", "call", DEST, OBJ, IFACE, "getPrimaryBrightness"],
            capture_output=True, text=True, timeout=5).stdout.strip()
        # busctl prints e.g. "u 36"
        toks = out.split()
        return _clamp(int(toks[-1]))
    except Exception:
        return None


# ---- direction A: brightness-ac -> setPrimaryBrightness --------------------
def forward(v):
    global _last_forward
    try:
        iv = _clamp(float(v))
    except (TypeError, ValueError):
        return
    if iv == _last_forward:
        return
    _last_forward = iv
    set_primary(iv)
    if DEBUG:
        warn("A: brightness-ac=%s -> setPrimaryBrightness(%d)" % (v, iv))


def monitor_loop():
    """Watch brightness-ac and forward every change to setPrimaryBrightness."""
    global _last_ac_change
    while True:
        try:
            proc = subprocess.Popen(["gsettings", "monitor", SCHEMA, KEY],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    text=True, bufsize=1)
        except Exception as e:
            warn("cannot start gsettings monitor: %s" % e)
            time.sleep(3)
            continue
        try:
            for line in proc.stdout:
                if ":" not in line:
                    continue
                with _lock:
                    _last_ac_change = time.time()
                forward(line.rsplit(":", 1)[1].strip())
        except Exception:
            pass
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            pass
        time.sleep(2)


# ---- direction B: current brightness -> brightness-ac ---------------------
def reflect_loop():
    while True:
        time.sleep(POLL)
        with _lock:
            recent = (time.time() - _last_ac_change) < STABLE
        if recent:
            continue
        cur = get_primary()
        if cur is None:
            continue
        ac = get_ac()
        if ac is None:
            continue
        if abs(cur - ac) >= TOL:
            set_ac(cur)
            # our own write re-enters direction A and re-applies `cur` (no-op
            # for the daemon since it is already there).
            if DEBUG:
                warn("B: brightness %d -> brightness-ac (was %s)" % (cur, ac))


def main():
    warn("started (pid %d)%s" % (os.getpid(), " [debug]" if DEBUG else ""))
    threading.Thread(target=monitor_loop, daemon=True).start()
    reflect_loop()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
