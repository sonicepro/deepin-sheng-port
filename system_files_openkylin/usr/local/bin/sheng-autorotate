#!/usr/bin/env python3
# sheng-autorotate
# ------------------------------------------------------------------
# Reads the Qualcomm SSC 3-axis accelerometer (icm4x6xx) through libssc
# (the `ssccli` helper) and drives openKylin/UKUI's screen rotation via the
# session D-Bus interface `com.kylin.statusmanager.interface.set_rotation`.
#
# Runs as the desktop user (luser) so it can talk to the session bus.
# The accelerometer device node /dev/fastrpc-adsp is made accessible to the
# `luser` group by /etc/udev/rules.d/70-sheng-fastrpc.rules.
# ------------------------------------------------------------------
import math
import os
import re
import subprocess
import sys
import time

IFACE = "com.kylin.statusmanager.interface"
OBJ = "/"
POLL = re.compile(r"X=(-?\d+(?:\.\d+)?)\s+Y=(-?\d+(?:\.\d+)?)\s+Z=(-?\d+(?:\.\d+)?)")

# While the panel is blanked we must NOT rotate: a rotation reconfigures the
# output and kylin-wlcom un-blanks the panel on it, so the screen would light
# back up on its own.  sheng-screen-toggle (the power-key "关闭显示器" action)
# creates/removes this per-user marker.
SCREEN_OFF = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()),
    "sheng-panel-off")

# ----- calibration ---------------------------------------------------
# The accelerometer reports specific force in m/s^2 with the sensor's own
# axes (firmware mount-matrix is all-zero, so we work in raw sensor axes).
# For the Xiaomi Pad 6S Pro (sheng):
#   * Z  is (anti-)parallel to the display normal
#   * in the tablet's *normal* (landscape) orientation gravity points ~ +X
# We classify the in-plane gravity direction into one of the four rotations
# UKUI supports: normal / left / right / upside-down.
FLAT_RATIO = 0.80      # |gz|/|g| above this -> lying flat, don't rotate
MIN_G = 3.0            # |g| below this -> free-fall/noise, ignore
DEBOUNCE = 0.6         # seconds a new orientation must persist

# angle ranges (degrees of atan2(gy,gx)) -> orientation string
ANGLE_MAP = [
    (-45.0,  45.0, "normal"),   # gravity ~ +X  (normal landscape)
    ( 45.0, 135.0, "left"),     # gravity ~ +Y
    (135.0, 225.0, "upside-down"),  # gravity ~ -X  (180 deg landscape)
    (225.0, 315.0, "right"),    # gravity ~ -Y
]


def classify(gx, gy, gz):
    mag = math.sqrt(gx * gx + gy * gy + gz * gz)
    if mag < MIN_G:
        return None
    if abs(gz) > FLAT_RATIO * mag:
        return None  # laid flat on a table
    a = math.degrees(math.atan2(gy, gx))
    if a < 0:
        a += 360.0
    for lo, hi, name in ANGLE_MAP:
        if lo <= a < hi:
            return name
    return "normal"


def set_rotation(orientation):
    """Ask kylin-status-manager to rotate the screen; True on success."""
    try:
        r = subprocess.run(
            ["dbus-send", "--session", "--print-reply", "--dest=" + IFACE, OBJ,
             IFACE + ".set_rotation",
             "string:" + orientation, "string:sheng-autorotate", "string:autorotate"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        return r.returncode == 0
    except Exception as e:
        warn("set_rotation(%s) failed: %s" % (orientation, e))
        return False


def warn(msg):
    sys.stderr.write("sheng-autorotate: %s\n" % msg)
    sys.stderr.flush()


def main():
    debug = "--debug" in sys.argv or os.environ.get("SHENG_AUTOROTATE_DEBUG")
    warn("started (pid %d)%s" % (os.getpid(), " [debug]" if debug else ""))
    cur = None
    pending = None
    pending_since = 0.0
    while True:
        try:
            p = subprocess.Popen(
                ["ssccli", "--sensor", "accelerometer", "--timeout", "3600"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                text=True, bufsize=1)
        except Exception as e:
            warn("cannot start ssccli: %s" % e)
            time.sleep(5)
            continue
        try:
            for line in p.stdout:
                m = POLL.search(line)
                if not m:
                    continue
                gx, gy, gz = (float(m.group(i)) for i in (1, 2, 3))
                o = classify(gx, gy, gz)
                if debug:
                    warn("g=(%.2f,%.2f,%.2f) -> %s (cur=%s)" % (gx, gy, gz, o, cur))
                if o is None or o == cur:
                    pending = None
                    continue
                # Panel blanked -> a rotation would un-blank it; skip (and let the
                # next sample after it comes back rotate if needed).
                if os.path.exists(SCREEN_OFF):
                    pending = None
                    continue
                now = time.time()
                if o != pending:
                    pending = o
                    pending_since = now
                elif now - pending_since >= DEBOUNCE:
                    # Only latch the new state once the D-Bus call actually
                    # succeeded; otherwise keep it as pending so the next sample
                    # retries (the status-manager / session may not be up yet at
                    # login time).
                    if set_rotation(o):
                        cur = o
                        pending = None
                        if debug:
                            warn("ROTATE -> %s" % o)
                    else:
                        pending = None  # retry from the next sample
        except Exception as e:
            warn("reader error: %s" % e)
        finally:
            try:
                p.terminate()
                p.wait(timeout=5)
            except Exception:
                pass
        time.sleep(3)  # ssccli ended/errored -> restart it


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
