[Unit]
Description=sheng fingerprint unlock wake (light panel when unlocked while dark)
Documentation=https://github.com/sonicepro/deepin-sheng-port
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sheng-fp-unlock-wake
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
