[Unit]
Description=Sheng Display-slider brightness bridge (brightness-ac <-> UKUI setPrimaryBrightness)
Documentation=https://github.com/sonicepro/deepin-sheng-port
# graphical-session.target is the proper dependency; default.target is added
# too so the daemon comes up even if ukui-session does not reach the former.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sheng-brightness-ac-bridge
Restart=always
RestartSec=3

[Install]
WantedBy=default.target graphical-session.target
