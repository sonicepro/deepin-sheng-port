# Shell scripts and workflow YAML must keep LF endings (they run on Linux CI).
*.sh   text eol=lf
mkbootimg text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.c    text eol=lf
*.network text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py     text eol=lf
*.colors text eol=lf
*.theme  text eol=lf
*      text=auto
