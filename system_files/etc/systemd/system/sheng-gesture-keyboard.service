[Unit]
Description=3-finger swipe up -> show on-screen keyboard (onboard)
After=graphical.target

[Service]
# Runs as the desktop user; reads the touchscreen directly and calls onboard's
# session-bus method org.onboard.Onboard.Keyboard.Show(). Uses the user's session
# bus explicitly (a system unit has no session env of its own).
Type=simple
User=luser
Environment=HOME=/home/luser
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python3 /usr/local/sbin/sheng-gesture-keyboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
