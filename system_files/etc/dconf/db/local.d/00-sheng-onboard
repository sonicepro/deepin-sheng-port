# sheng defaults: make the on-screen keyboard (onboard) touch-friendly.
# Docks it full-width at the bottom, Blackboard skin + Small layout, auto-shows on
# text focus. This is a SYSTEM dconf default (system-db:local), so the login
# greeter (running as the lightdm user) picks up the same skin as the desktop.
# window-handles='' removes the drag handles entirely -> a stray multi-finger drag
# can no longer resize the keyboard (onboard shows its resize grips on a
# multi-finger drag whenever the MOVE handle is present). On-demand resizing is done
# from the Enter long-press popup: the build patches the Small layout (that popup's
# "hide keyboard" button becomes a "move/resize" button) and patches onboard's
# BCMove.update so that button stays visible without the MOVE handle. Requires
# dconf-cli so `dconf update` compiles this into /etc/dconf/db/local (see docs).
[org/onboard]
theme='Blackboard'
layout='Small'
use-system-defaults=true

[org/onboard/window]
docking-enabled=true
docking-edge='bottom'
force-to-top=true
window-handles=''

[org/onboard/auto-show]
enabled=true
hide-on-key-press=true

[org/onboard/lockdown]
disable-touch-handles=false

[org/onboard/keyboard]
touch-input='multi'
audio-feedback-enabled=false
